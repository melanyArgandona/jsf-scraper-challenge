# ============================================================
# Configuracion del scraper (copiar a .env y ajustar).
# El archivo .env NO se sube al repositorio (esta en .gitignore).
# ============================================================

# Sitio activo: "oefa" (defecto, tabla TFA) | "pj" (jurisprudencia PJ, tarjetas)
SCRAPER_SITE=oefa

# --- URLs (opcional, sobreescribe el perfil) ---
# BASE_URL=https://jurisprudencia.pj.gob.pe
# START_URL=https://jurisprudencia.pj.gob.pe/jurisprudenciaweb/faces/page/resultado.xhtml
# SEARCH_PATH=

# --- Campos de busqueda JSF (sobreescribe el perfil) ---
# JSF_SEARCH_INPUT=formBusqueda:txtBusqueda
# JSF_SEARCH_BUTTON=formBusqueda:btnBuscar

# --- Mapeo de columnas OEFA (indice -> campo). null descarta. ---
# COLUMNS=numero,nroExpediente,administrado,unidadFiscalizable,sector,nroResolucionApelacion

# --- Mecanismo de descarga (mojarra | link) ---
# DOWNLOAD_MODE=mojarra
# DOWNLOAD_SIGNATURE=mojarra\.jsfcljs
# DOWNLOAD_PARAM_KEY=param_uuid
# DOWNLOAD_LINK_SELECTOR=a[href$='.pdf']
# DOWNLOAD_LINK_ATTR=href

# ============================================================
# BYPASS de WAF (PJ bloquea clientes no navegador con 403).
# En el navegador: abre la pagina, DevTools > Application > Cookies,
# copia la cookie de sesion (p.ej. JSESSIONID u otra) y pegala aqui.
# Formato: "nombre1=valor1; nombre2=valor2"
# ============================================================
# EXTRA_COOKIES=JSESSIONID=abc123...
# EXTRA_HEADERS={"X-Requested-With":"XMLHttpRequest"}

# --- Reintentos / cortesia ---
MAX_RETRIES=3
BACKOFF_MS=1500
MAX_BACKOFF_MS=60000
COURTESY_DELAY_MS=1500

# --- Persistencia de fallidos (modo --resume) ---
FAILURES_PATH=output/fallidas.json

# --- PJ: ajustes finos del layout de tarjetas (tras inspeccionar el DOM) ---
# PJ_CARD_SELECTOR=div.ui-panel
# PJ_BUTTON_TEXT=Ver Resolución
# PJ_TABLE_ID=formBusqueda:tablaResultados
# PJ_BUTTON_ID=formBusqueda:tablaResultados:${index}:btnVerResolucion
